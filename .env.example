# Environment variables for Law AI Agent
# Copy this file to .env and fill in the values

# Backend
SECRET_KEY=your-super-secret-key-change-this-in-production

# AI Provider (gigachat, groq or openai)
AI_PROVIDER=gigachat

# GigaChat API (для пользователей в РФ)
GIGACHAT_CLIENT_ID=your-gigachat-client-id
GIGACHAT_CLIENT_SECRET=your-gigachat-client-secret
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-Pro

# GROQ API (альтернатива)
GROQ_API_KEY=sk-your-groq-api-key-here

# OpenAI API (fallback)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Google OAuth (для авторизации через Google)
# Инструкция: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Email (для восстановления пароля)
# Для Gmail: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Law AI Agent

# Database (for Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=law_ai_agent

# n8n
N8N_ENCRYPTION_KEY=your-n8n-encryption-key
